# Copy to .env and fill in real values. .env is gitignored.

# --- Database ---
# Local dev: matches docker-compose.yml credentials.
# Prod (Railway): set to the managed Postgres DATABASE_URL.
DATABASE_URL=postgresql://athena:athena@localhost:5432/athena

# --- Polymarket ---
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
# Polygon RPC for on-chain trade ingestion (e.g. Alchemy, Infura).
POLYGON_RPC_URL=

# --- Dune Analytics (Phase 1 validation queries) ---
DUNE_API_KEY=

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- App ---
LOG_LEVEL=INFO
